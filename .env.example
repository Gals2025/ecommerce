# Copy to .env (local) or set in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values — .env* is gitignored.

# Postgres connection (Neon). Required for app + drizzle-kit migrate/seed.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Public base URL used for metadata/sitemap links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Blob store token. REQUIRED for admin catalog image uploads
# (POST /api/admin/catalog/upload). Without it, uploads fail with
# "Image storage is not configured." Connect a Blob store to the project
# in Vercel Storage (auto-injects this var), then redeploy.
BLOB_READ_WRITE_TOKEN=

# Auth (JWT sessions).
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Transactional email (Resend). Required for password reset / order emails.
RESEND_API_KEY=
EMAIL_FROM=Pickle Unltd <noreply@example.com>

# Optional: backfill an admin via `npm run db:make-admin`.
ADMIN_EMAIL=

# Local dev seed only. NEVER set in production (seed.ts refuses to run).
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
